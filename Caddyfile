# Global options: email is required by Let's Encrypt for certificate expiry notices
{
    email {$ACME_EMAIL}
}

# Browser hardening headers, reused on every site below via `import security_headers`.
# No page anywhere in this project embeds another page in an iframe (checked: zero
# <iframe> tags in site/ or app/public/), so frame-ancestors 'self' is safe -- it still
# lets a tenant's own pages sit inside each other if that's ever needed, just blocks a
# third-party site from framing this one (clickjacking). geolocation stays unrestricted
# (self) because payroll.html's clock-in uses navigator.geolocation on the same origin.
# Text, scripts and JSON are compressed on the way out (zstd or gzip): much less data on slow phones.
(compress) {
    encode zstd gzip
}

(security_headers) {
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "camera=(), microphone=(), payment=(), usb=(), magnetometer=(), gyroscope=(), geolocation=(self)"
        # frame-ancestors: nobody else may frame us. object-src: no plugins. base-uri: a injected <base> tag cannot redirect our relative links.
        Content-Security-Policy "frame-ancestors 'self'; object-src 'none'; base-uri 'self'"
        -Server
    }
}

# The root domain is the AUZlabs marketing site.
{$DOMAIN} {
    import security_headers
    import compress
    root * /srv/site
    # iOS Safari (especially a Home Screen web-clip) has been seen serving
    # a stale cached copy of a page's own HTML even after a fresh deploy --
    # every reported "still showing the old header" turned out to be this,
    # not the deploy itself. no-cache forces a revalidation request every
    # time instead of trusting the local cache blindly (same reasoning as
    # the /sw.js rule below already uses).
    header /*.html Cache-Control "no-cache"
    # A customer's short bill link: auzslab.in/b/<code>. The server finds which bill it is and forwards to the page that shows it.
    handle /b/* {
        uri replace /b /bill 1
        reverse_proxy api:3000
    }
    file_server
    # a mistyped or old link shows a branded page (still answers 404 so search engines drop it) instead of a bare "404 Not Found"
    handle_errors {
        rewrite * /404.html
        file_server
    }
}

# ---- Addresses under the main domain ------------------------------------------------------------------------------------------
# Only these exist (the main site, api., status., agents. have their own blocks):
#   * ONE shared address per app: auzspos (POS + its Admin console), auzsstyle, auzsmob, auzspay, auzsledger, auzsscan, auzsfinance,
#     and app = the hub (start page, "build your own software", customers' bill pages).
#     Each address serves ONLY its own app's files. Which business you see is decided by signing in, never by the address.
#   * every other name (shopname.auzslab.in) is a SHOP address. It exists only for a shop that has website access (an online store,
#     QR ordering, a salon website or a custom-built website) and serves only that website. The server decides (routes/sites.js asks
#     the database); an app page typed on a shop address is forwarded to the app's own address for 30 days, then shows "page not found".
# A wildcard cert can't use the normal HTTP challenge, so it uses a DNS-01 challenge via the registrar's API.
# GODADDY_API_TOKEN is KEY:SECRET from developer.godaddy.com/keys (see .env.example).

# files every app page needs (shared look, sign-in code, icons): none of them opens an app by itself
(shared_files) {
    @shared path /sw.js /offline.html /config.js /tenant.js /sb-client.js /ds/* /vendor/* /fonts/* /assets/* /icon-* /logo* /manifest.json /manifest-*.json /boot-splash.* /hig.*
}
# one app address: {args[0]} is the page the bare address opens, the rest are this app's own files
(one_app) {
    import shared_files
    route {
        # the hub's combined workspace shows these apps inside its own page; nobody else may frame them
        header Content-Security-Policy "frame-ancestors 'self' https://app.{$DOMAIN}; object-src 'none'; base-uri 'self'"
        @home path /
        rewrite @home {args[0]}
        @mine path {args[0]} {args[1:]}
        file_server @mine
        file_server @shared
        error 404
    }
}

*.{$DOMAIN} {
    tls {
        dns godaddy {env.GODADDY_API_TOKEN}
        # GoDaddy's own propagation is slow enough that Let's Encrypt's
        # *secondary* validation (from other global vantage points, an
        # anti-hijacking check) was seeing NXDOMAIN and failing even
        # though the record existed and Caddy's own check had already
        # passed -- confirmed against the real logs while setting this
        # up. Wait before checking at all, then allow more total time.
        propagation_delay 2m
        propagation_timeout 5m
    }
    import security_headers
    import compress
    root * /srv/app
    # a stale cached service worker can pin clients to old code indefinitely
    header /sw.js Cache-Control "no-cache"
    # tenant.js decides which business (or shared address) a page belongs to: a stale cached copy once kept auzsmob.auzslab.in on the POS
    header /tenant.js Cache-Control "no-cache"
    # same reasoning, for the actual app-shell HTML itself (index.html,
    # payroll.html, site.html, ...) -- see the root domain
    # block above for the full story on why this exists.
    # the bare address "/" (land.html decides where it goes) must never be cached either, or a phone keeps the old redirect
    header / Cache-Control "no-cache"
    header /*.html Cache-Control "no-cache"
    # ds/docread.js dynamically `import()`s vendor/pdfjs/pdf.min.mjs (and its worker) to read a
    # PDF's own text -- a browser refuses to run a dynamically imported module unless it is
    # served with a JavaScript Content-Type, and does not fall back to sniffing one, so a server
    # (or proxy) that serves .mjs with the wrong or no Content-Type breaks the import outright
    # ("Failed to fetch dynamically imported module"), never a 404 or anything else visible in
    # the console. Forced explicitly rather than trusting Caddy's own extension guess.
    @mjs path_regexp \.mjs$
    header @mjs Content-Type "text/javascript; charset=utf-8"
    handle_errors {
        header Content-Type "text/html; charset=utf-8"
        respond `<!doctype html><meta charset=utf-8><meta name=viewport content="width=device-width,initial-scale=1"><title>Page not found</title><body style="font:16px system-ui,sans-serif;display:grid;place-items:center;min-height:100vh;margin:0;color:#222"><div style="text-align:center"><h1 style="font-size:20px">Page not found</h1><p>Visit <a href="https://{$DOMAIN}">AUZslab</a>.</p></div></body>` {err.status_code}
    }
    # www is the main site
    @www host www.{$DOMAIN}
    redir @www https://{$DOMAIN}{uri} permanent
    # ---- the shared app addresses ----
    @a_pos host auzspos.{$DOMAIN}
    handle @a_pos {
        handle /app-manifest.json {
            reverse_proxy api:3000
        }
        handle /app-icon/* {
            reverse_proxy api:3000
        }
        import one_app /index.html /index.html /dashboard.html /backoffice.html /pos/* /console/*
    }
    @a_style host auzsstyle.{$DOMAIN}
    handle @a_style {
        import one_app /style.html /style.html /style/*
    }
    @a_mob host auzsmob.{$DOMAIN}
    handle @a_mob {
        import one_app /mob.html /mob.html /mob/*
    }
    @a_pay host auzspay.{$DOMAIN}
    handle @a_pay {
        import one_app /payroll.html /payroll.html /payroll/*
    }
    @a_ledger host auzsledger.{$DOMAIN}
    handle @a_ledger {
        import one_app /accounts.html /accounts.html /accounts/*
    }
    @a_scan host auzsscan.{$DOMAIN}
    handle @a_scan {
        import one_app /scan.html /scan.html /accounts/*
    }
    @a_fin host auzsfinance.{$DOMAIN}
    handle @a_fin {
        import one_app /finance.html /finance.html /finance/*
    }
    # the hub: also shows a customer's bill (their link is auzslab.in/b/<code>, which forwards here)
    @a_hub host app.{$DOMAIN}
    handle @a_hub {
        import one_app /start.html /start.html /start.js /verify.html /my.html /my.js /my.css /admin/* /stybill.html /stybill.js /bill.html /mobbill.html /i.html /mob/receipt* /accounts/bill.js /accounts/invoice-templates.js /accounts/taxinv.js /accounts/accounts.css /chapterone/logo-full.png
    }

    # ---- every other name: a shop address, only for a shop with a website ----
    handle {
        route {
            import shared_files
            # the server (routes/sites.js) answers 200 (this shop has a website), 302 (old address: forwarded to the app address) or 404
            @page {
                not path_regexp \.(js|css|png|jpe?g|webp|svg|woff2?|ico|json|mjs|txt|mp3|map|gif)$
                not path /uploads/*
            }
            forward_auth @page api:3000 {
                uri /site/check
                copy_headers X-Site-Kind
            }
            # per-shop website files only: no app page can be served here whatever the server says
            # the salon website and its own API belong to salon shops only
            @salonOnly {
                path /salon/* /i/* /api/*
                not path_regexp \.(js|css|png|jpe?g|webp|svg|woff2?|ico|json|mjs|txt|mp3|map|gif)$
                not header X-Site-Kind salon
            }
            error @salonOnly 404
            header /salon/* Cache-Control "no-cache, must-revalidate"
            handle /api/* {
                uri replace /api /salon-api 1
                reverse_proxy api:3000
            }
            handle_path /uploads/* {
                root * /srv/uploads
                # uploaded files get a new name every time, so browsers may keep them for a year
                header Cache-Control "public, max-age=31536000, immutable"
                file_server
            }
            handle /app-manifest.json {
                reverse_proxy api:3000
            }
            handle /app-icon/* {
                reverse_proxy api:3000
            }
            # Link-preview bots (WhatsApp, Facebook, Telegram ...) get a small page with this salon's own title, text and picture
            @previewBot {
                header User-Agent *WhatsApp*
                path / /salon/ /salon/index.html
            }
            @previewBot2 {
                header_regexp ua User-Agent (?i)(facebookexternalhit|twitterbot|telegrambot|linkedinbot|slackbot|discordbot)
                path / /salon/ /salon/index.html
            }
            handle @previewBot {
                rewrite * /salon-api/share
                reverse_proxy api:3000
            }
            handle @previewBot2 {
                rewrite * /salon-api/share
                reverse_proxy api:3000
            }
            # Store links (/store.html?p=<product>): preview bots get the product's own picture, name and price
            @storeBot {
                header_regexp ua User-Agent (?i)(whatsapp|facebookexternalhit|twitterbot|telegrambot|linkedinbot|slackbot|discordbot)
                path /store.html
            }
            handle @storeBot {
                rewrite * /store-share?{query}
                reverse_proxy api:3000
            }
            # short bill links on a shop address (the main link is auzslab.in/b/<code>)
            @styBill path_regexp ^/b/[a-f0-9]{8,32}$
            rewrite @styBill /stybill.html
            @salonInvoice path_regexp ^/i/[a-f0-9]{8,32}$
            rewrite @salonInvoice /salon/invoice.html
            @salonDir path_regexp sd ^(/salon(?:/[a-z]+)?)/?$
            rewrite @salonDir {re.sd.1}/index.html
            # the bare address opens this shop's website, by kind
            @kStore {
                path /
                header X-Site-Kind store
            }
            rewrite @kStore /store.html
            @kQr {
                path /
                header X-Site-Kind qr
            }
            rewrite @kQr /site.html
            @kSalon {
                path /
                header X-Site-Kind salon
            }
            rewrite @kSalon /salon/index.html
            @kCustom {
                path /
                header X-Site-Kind custom
            }
            rewrite @kCustom /custom.html
            # the website pages go through the API so each shop's own home-screen icon is written INTO the page (an iPhone ignores
            # a home-screen icon that is linked by address or set by script)
            @iconPages path /site-kiln.html /site.html /store.html
            handle @iconPages {
                reverse_proxy api:3000
            }
            @web path /site.html /site-kiln.html /store.html /store/* /site-edit.html /site-schemas.js /salon/* /custom.html /chapterone/* /bailamos/* /radz/* /stybill.html /stybill.js /bill.html /mobbill.html /i.html /order.html /w.html /terms.html /privacy.html /mob/receipt* /accounts/bill.js /accounts/invoice-templates.js /accounts/taxinv.js /accounts/accounts.css /app-manifest.json /app-icon/*
            handle @web {
                file_server
            }
            handle @shared {
                file_server
            }
            handle {
                error 404
            }
        }
    }
}

# Monitoring dashboard, kept on its own subdomain
status.{$DOMAIN} {
    import security_headers
    import compress
    reverse_proxy uptime-kuma:3001
}

# Agents Office (the owner's AI team dashboard): a separate app with its own login, AI key and notes folder,
# started only with `docker compose --profile agents up -d --build agents-office`. Until then this address shows 502.
agents.{$DOMAIN} {
    import security_headers
    import compress
    reverse_proxy agents-office:3100
}

# This project's own API (server/) -- auth, the data API, RPC, realtime
# (the /ws upgrade goes through the same reverse_proxy transparently),
# and Web Push. /uploads/* is file storage (server/src/storage.js writes
# there; this just serves it back out, publicly and directly -- no need
# to round-trip through Node for a static file). CORS is handled by the
# api service itself (every response already carries
# Access-Control-Allow-Origin), not duplicated here.
api.{$DOMAIN} {
    import security_headers
    import compress
    handle_path /uploads/* {
        root * /srv/uploads
        # uploaded files get a new name every time, so browsers may keep them for a year
        header Cache-Control "public, max-age=31536000, immutable"
        file_server
    }
    handle {
        reverse_proxy api:3000
    }
}
