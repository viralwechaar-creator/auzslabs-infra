# Global options: email is required by Let's Encrypt for certificate expiry notices
{
    email {$ACME_EMAIL}
}

# Browser hardening headers, reused on every site below via `import security_headers`.
# No page anywhere in this project embeds another page in an iframe (checked: zero
# <iframe> tags in site/ or app/public/), so frame-ancestors 'self' is safe -- it still
# lets a tenant's own pages sit inside each other if that's ever needed, just blocks a
# third-party site from framing this one (clickjacking). geolocation stays unrestricted
# (self) because payroll.html's clock-in uses navigator.geolocation on the same origin.
(security_headers) {
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "camera=(), microphone=(), payment=(), usb=(), magnetometer=(), gyroscope=(), geolocation=(self)"
        Content-Security-Policy "frame-ancestors 'self'"
        -Server
    }
}

# The root domain is the AUZlabs marketing site.
{$DOMAIN} {
    import security_headers
    root * /srv/site
    # iOS Safari (especially a Home Screen web-clip) has been seen serving
    # a stale cached copy of a page's own HTML even after a fresh deploy --
    # every reported "still showing the old header" turned out to be this,
    # not the deploy itself. no-cache forces a revalidation request every
    # time instead of trusting the local cache blindly (same reasoning as
    # the /sw.js rule below already uses).
    header /*.html Cache-Control "no-cache"
    file_server
}

# Every client's subdomain serves the POS app. Which client it is gets
# figured out client-side (tenant.js reads the subdomain) or via RLS
# once a staff member logs in — same files for every tenant.
# A wildcard cert can't use the normal HTTP challenge (there's no single
# server to answer it for every possible subdomain) -- it needs a DNS-01
# challenge instead, proving control of the domain by creating a TXT
# record via the registrar's API. GODADDY_API_TOKEN is KEY:SECRET from
# developer.godaddy.com/keys (see .env.example).
*.{$DOMAIN} {
    tls {
        dns godaddy {env.GODADDY_API_TOKEN}
        # GoDaddy's own propagation is slow enough that Let's Encrypt's
        # *secondary* validation (from other global vantage points, an
        # anti-hijacking check) was seeing NXDOMAIN and failing even
        # though the record existed and Caddy's own check had already
        # passed -- confirmed against the real logs while setting this
        # up. Wait before checking at all, then allow more total time.
        propagation_delay 2m
        propagation_timeout 5m
    }
    import security_headers
    root * /srv/app
    # a stale cached service worker can pin clients to old code indefinitely
    header /sw.js Cache-Control "no-cache"
    # same reasoning, for the actual app-shell HTML itself (index.html,
    # payroll.html, builder.html, site.html, ...) -- see the root domain
    # block above for the full story on why this exists.
    header /*.html Cache-Control "no-cache"
    # Salon Suite (app/public/salon/ -- Showoff Salon's original site,
    # admin console and invoice page, run for 'salon'-niche tenants):
    #  - /api/* is that app's own same-origin API (server/src/salon.js),
    #    tenant resolved from this subdomain (Host is passed through);
    #  - /i/<token> is its public, shareable invoice link;
    #  - /uploads/* serves images/audio the salon admin uploaded.
    # None of these paths are used by the POS app, so other niches are unaffected.
    header /salon/* Cache-Control "no-cache, must-revalidate"
    handle /api/* {
        uri replace /api /salon-api 1
        reverse_proxy api:3000
    }
    handle_path /uploads/* {
        root * /srv/uploads
        file_server
    }
    # Everything else. Wrapped in handle so the /api and /uploads blocks
    # above win: Caddy runs try_files BEFORE handle in its fixed directive
    # order, so a bare top-level try_files would rewrite /api/site to
    # /land.html before those blocks ever saw it.
    handle {
        # try_files below doesn't count a bare directory (/salon/,
        # /salon/menu/, /salon/admin/) as an existing file and would hand
        # it to land.html, which redirects straight back here (a loop) --
        # so map them to their index.html explicitly first.
        @salonDir path_regexp sd ^(/salon(?:/[a-z]+)?)/?$
        rewrite @salonDir {re.sd.1}/index.html
        @salonInvoice path_regexp ^/i/[a-f0-9]{8,32}$
        rewrite @salonInvoice /salon/invoice.html
        file_server
        # A request for a real file (index.html, booking.html, site.html,
        # backoffice.html, ...) is served directly, above -- this fallback
        # only fires for a path that isn't one, in practice almost always
        # the bare subdomain root. land.html is the one place that decides
        # which page is a given tenant's real front door, by niche (a
        # salon's is the /salon/ app, not the staff POS) -- see its own
        # comment for why this used to just be index.html unconditionally.
        try_files {path} /land.html
    }
}

# Monitoring dashboard, kept on its own subdomain
status.{$DOMAIN} {
    import security_headers
    reverse_proxy uptime-kuma:3001
}

# This project's own API (server/) -- auth, the data API, RPC, realtime
# (the /ws upgrade goes through the same reverse_proxy transparently),
# and Web Push. /uploads/* is file storage (server/src/storage.js writes
# there; this just serves it back out, publicly and directly -- no need
# to round-trip through Node for a static file). CORS is handled by the
# api service itself (every response already carries
# Access-Control-Allow-Origin), not duplicated here.
api.{$DOMAIN} {
    import security_headers
    handle_path /uploads/* {
        root * /srv/uploads
        file_server
    }
    handle {
        reverse_proxy api:3000
    }
}
