# Global options: email is required by Let's Encrypt for certificate expiry notices
{
    email {$ACME_EMAIL}
}

# The root domain is the AUZlabs marketing site.
{$DOMAIN} {
    root * /srv/site
    file_server
}

# Every client's subdomain serves the POS app. Which client it is gets
# figured out client-side (tenant.js reads the subdomain) or via RLS
# once a staff member logs in — same files for every tenant.
*.{$DOMAIN} {
    root * /srv/app
    file_server
    try_files {path} /index.html
}

# Monitoring dashboard, kept on its own subdomain
status.{$DOMAIN} {
    reverse_proxy uptime-kuma:3001
}

# Self-hosted Supabase's own gateway (container alias "kong", port 8000).
# Serves the REST/Auth/Storage/Realtime API *and* the Studio dashboard
# (Studio is behind the DASHBOARD_USERNAME/PASSWORD basic auth baked into
# the gateway itself, not set up again here). This is a more specific host
# match than the *.{$DOMAIN} wildcard above, so Caddy routes it here first
# regardless of block order.
api.{$DOMAIN} {
    reverse_proxy kong:8000
}

# NOTE: the wildcard *.{$DOMAIN} above needs a DNS-01 challenge (a Caddy DNS
# plugin for your registrar) for its certificate, not the plain HTTP
# challenge — set that up before this goes live with real client subdomains.
