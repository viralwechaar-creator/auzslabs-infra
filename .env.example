# Copy this file to .env and fill in real values. Never commit .env itself.

# --- Domain & HTTPS ---
DOMAIN=auzslab.in
ACME_EMAIL=you@auzslab.in

# --- Postgres ---
POSTGRES_USER=auzlabs
POSTGRES_PASSWORD=changeme_use_a_long_random_password
POSTGRES_DB=auzlabs

# --- Backup retention ---
BACKUP_KEEP_DAYS=7
BACKUP_KEEP_WEEKS=4
BACKUP_KEEP_MONTHS=6
