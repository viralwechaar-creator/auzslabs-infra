# Copy this file to .env and fill in real values. Never commit .env itself.

# --- Domain & HTTPS ---
DOMAIN=auzslab.in
ACME_EMAIL=you@auzslab.in

# --- DNS-01 challenge for the wildcard cert (*.{$DOMAIN}, one cert
# covering every client subdomain) -- needed because there's no single
# server able to answer the normal HTTP challenge for every possible
# subdomain. Get KEY and SECRET from developer.godaddy.com/keys (create
# a Production key), then set this to KEY:SECRET, colon-joined.
GODADDY_API_TOKEN=changeme_key:changeme_secret

# --- Postgres ---
# POSTGRES_USER/PASSWORD is the bootstrap superuser the official image
# creates -- used only for the container's own init and by ./backup.
# The API server must NEVER connect with these: the Docker postgres
# image always makes POSTGRES_USER a superuser, and superusers silently
# bypass every RLS policy in this schema regardless of what it says.
POSTGRES_USER=auzlabs
POSTGRES_PASSWORD=changeme_use_a_long_random_password
POSTGRES_DB=auzlabs

# The ordinary, non-superuser role db/000b_create_app_role.sh creates --
# this is what the API server actually connects as, so RLS applies.
POSTGRES_APP_PASSWORD=changeme_use_a_different_long_random_password

# --- API server (server/) ---
# Required. Signs login sessions -- generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=changeme_use_a_long_random_value

# Optional -- push notifications silently no-op without these. Generate
# with: node server/scripts/generate-vapid-keys.js
VAPID_PUBLIC=
VAPID_PRIVATE=
VAPID_SUBJECT=https://auzslab.in

# --- Transactional email (Resend) ---
# Used for one thing right now: confirming a new staff login's email
# address before it can sign in (see db/044_staff_email_verification.sql).
# Without this set, invite_staff still works exactly as before -- the
# owner just also has to share the verification link directly (shown
# in account.html's Staff page) since no email goes out.
#   1. Sign up at resend.com (free tier: 3,000 emails/month)
#   2. Domains -> Add Domain -> auzslab.in -> add the 3 DNS records it
#      shows you at your registrar (same GoDaddy account as
#      GODADDY_API_TOKEN above) -- takes a few minutes to verify.
#      Until that's done, MAIL_FROM must stay on their onboarding@resend.dev
#      sending domain (works immediately, no setup, but only for testing).
#   3. API Keys -> Create API Key -- copy it into RESEND_API_KEY below
RESEND_API_KEY=
MAIL_FROM=AUZslab <onboarding@resend.dev>

# --- Backup retention ---
BACKUP_KEEP_DAYS=7
BACKUP_KEEP_WEEKS=4
BACKUP_KEEP_MONTHS=6

# --- Off-site backup copy (Backblaze B2) ---
# Without this, backups only ever exist on this same VPS -- a lost
# or corrupted server loses the live data AND every backup of it at
# once. B2's free tier (10GB storage, uploads always free) covers
# this project's actual backup size for a long time; no card needed
# to sign up for it.
#   1. Sign up at backblaze.com/b2 (or log in if you already have one)
#   2. Buckets > Create a Bucket -- name it e.g. "auzslab-backups",
#      Private -- copy that name into B2_BUCKET below
#   3. App Keys > Add a New Application Key -- Bucket: pick the one
#      you just made (NOT "All"), Type: Read and Write -- copy the
#      keyID into B2_KEY_ID and the applicationKey into
#      B2_APPLICATION_KEY the moment it's created (shown once, never
#      again)
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET=
