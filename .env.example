# Copy this file to .env and fill in real values. Never commit .env itself.

# --- Domain & HTTPS ---
DOMAIN=auzslab.in
ACME_EMAIL=you@auzslab.in

# --- DNS-01 challenge for the wildcard cert (*.{$DOMAIN}, one cert
# covering every client subdomain) -- needed because there's no single
# server able to answer the normal HTTP challenge for every possible
# subdomain. Get KEY and SECRET from developer.godaddy.com/keys (create
# a Production key), then set this to KEY:SECRET, colon-joined.
GODADDY_API_TOKEN=changeme_key:changeme_secret

# --- Postgres ---
# POSTGRES_USER/PASSWORD is the bootstrap superuser the official image
# creates -- used only for the container's own init and by ./backup.
# The API server must NEVER connect with these: the Docker postgres
# image always makes POSTGRES_USER a superuser, and superusers silently
# bypass every RLS policy in this schema regardless of what it says.
POSTGRES_USER=auzlabs
POSTGRES_PASSWORD=changeme_use_a_long_random_password
POSTGRES_DB=auzlabs

# The ordinary, non-superuser role db/000b_create_app_role.sh creates --
# this is what the API server actually connects as, so RLS applies.
POSTGRES_APP_PASSWORD=changeme_use_a_different_long_random_password

# --- API server (server/) ---
# Required. Signs login sessions -- generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=changeme_use_a_long_random_value

# Optional -- push notifications silently no-op without these. Generate
# with: node server/scripts/generate-vapid-keys.js
VAPID_PUBLIC=
VAPID_PRIVATE=
VAPID_SUBJECT=https://auzslab.in

# --- Transactional email (Resend) ---
# Used for one thing right now: confirming a new staff login's email
# address before it can sign in (see db/044_staff_email_verification.sql).
# Without this set, invite_staff still works exactly as before -- the
# owner just also has to share the verification link directly (shown
# in account.html's Staff page) since no email goes out.
#   1. Sign up at resend.com (free tier: 3,000 emails/month)
#   2. Domains -> Add Domain -> auzslab.in -> add the 3 DNS records it
#      shows you at your registrar (same GoDaddy account as
#      GODADDY_API_TOKEN above) -- takes a few minutes to verify.
#      Until that's done, MAIL_FROM must stay on their onboarding@resend.dev
#      sending domain (works immediately, no setup, but only for testing).
#   3. API Keys -> Create API Key -- copy it into RESEND_API_KEY below
RESEND_API_KEY=
MAIL_FROM=AUZslab <onboarding@resend.dev>

# --- Real sign-in providers (Google / Apple / phone, db/069) ---
# Every one of these is optional and independent -- whichever are unset
# just make that sign-in button/flow stay hidden or reply "not configured
# yet" instead of breaking anything else. Email/password keeps working
# regardless.

# Google: console.cloud.google.com -> create or pick a project ->
# APIs & Services -> OAuth consent screen (fill in app name, support
# email, add auzslab.in as an authorized domain) -> Credentials ->
# Create Credentials -> OAuth client ID -> Application type: Web
# application -> Authorized JavaScript origins: add https://auzslab.in
# (and https://<your test domain> if you test before going live) ->
# Create. Copy the Client ID (NOT the secret -- this flow never needs
# it) into both of these:
GOOGLE_CLIENT_ID=
#   also paste the same value into window.CFG.googleClientId in
#   site/signup.html (and app/public pages, if you add the button
#   there too) -- that's the one place it needs to be public/client-side.

# Apple: developer.apple.com/account (needs a paid Apple Developer
# membership, $99/year) -> Certificates, Identifiers & Profiles ->
# Identifiers -> + -> Services IDs -> create one, e.g. "in.auzslab.web"
# (this becomes APPLE_CLIENT_ID below) -> enable "Sign in with Apple" ->
# Configure -> Primary App ID: any App ID on the account (create a bare
# one if you don't have an iOS app yet) -> Domains: auzslab.in ->
# Return URLs: https://auzslab.in/signup.html -> Save.
# Then Identifiers -> Keys -> + -> name it, check "Sign in with Apple",
# Configure -> pick the Primary App ID above -> Save -> Register ->
# Download (a .p8 file, shown once, never again -- keep it safe). Also
# note the Key ID shown on that download page, and your Team ID (top
# right of the developer account page, a 10-character code).
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_CLIENT_ID=
# The .p8 file's contents, newlines kept as literal \n (one line here):
#   awk 'NF {sub(/\r/, ""); printf "%s\\n", $0}' AuthKey_XXXXXXXXXX.p8
APPLE_PRIVATE_KEY=
#   also paste APPLE_CLIENT_ID into window.CFG.appleClientId in
#   site/signup.html, same as Google above.

# Phone/OTP: console.twilio.com -> sign up (free trial credit, no card
# needed to start) -> on the dashboard, copy Account SID and Auth Token
# -> Phone Numbers -> Buy a number (or use the free trial number) ->
# copy it in E.164 form (e.g. +14155550100) into TWILIO_FROM. A trial
# account can only text numbers you've verified in the console first --
# upgrade (add a card) once you're ready for real customers.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Online payment (Razorpay): a client on the cart page pays with
# card/UPI/netbanking and is auto-activated the instant the payment
# confirms -- no platform admin has to click Approve. Without these
# three values the cart page keeps working exactly as it does today
# (fill in the form, we review it by hand) -- nothing breaks either way.
#   1. dashboard.razorpay.com -> sign up -> complete KYC (PAN, and GST
#      if registered, plus a bank account for payouts -- this step is
#      Razorpay's own business verification and can take a day or two;
#      everything below works in Test Mode immediately while you wait).
#   2. Settings -> API Keys -> Generate Key (Test Mode first, then
#      again in Live Mode once KYC is approved) -- copy the Key Id and
#      Key Secret the moment they're shown (the secret is shown once).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
#   3. Settings -> Webhooks -> Add New Webhook -- URL:
#      https://api.auzslab.in/payments/webhook -- Active events: tick
#      "payment.captured" -- Secret: make up any long random string
#      and paste the SAME one here. This is what proves a webhook
#      request is really from Razorpay, not anyone else on the internet.
RAZORPAY_WEBHOOK_SECRET=
#   4. Once keys are in and the API container has been rebuilt, open
#      admin.html -> Pricing and set a real monthly price for each
#      product you want to sell online -- a product with no price (or
#      0) stays on the manual request-and-we-call-you flow, so you can
#      turn this on product by product whenever you're ready.

# --- Backup retention ---
BACKUP_KEEP_DAYS=7
BACKUP_KEEP_WEEKS=4
BACKUP_KEEP_MONTHS=6

# --- Off-site backup copy (Backblaze B2) ---
# Without this, backups only ever exist on this same VPS -- a lost
# or corrupted server loses the live data AND every backup of it at
# once. B2's free tier (10GB storage, uploads always free) covers
# this project's actual backup size for a long time; no card needed
# to sign up for it.
#   1. Sign up at backblaze.com/b2 (or log in if you already have one)
#   2. Buckets > Create a Bucket -- name it e.g. "auzslab-backups",
#      Private -- copy that name into B2_BUCKET below
#   3. App Keys > Add a New Application Key -- Bucket: pick the one
#      you just made (NOT "All"), Type: Read and Write -- copy the
#      keyID into B2_KEY_ID and the applicationKey into
#      B2_APPLICATION_KEY the moment it's created (shown once, never
#      again)
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET=
