# Copy this file to .env and fill in real values. Never commit .env itself.

# --- Domain & HTTPS ---
DOMAIN=auzslab.in
ACME_EMAIL=you@auzslab.in

# --- Postgres ---
# Must match POSTGRES_PASSWORD in the *Supabase* stack's own .env (a
# separate docker-compose project) -- this repo's backup service connects
# to Supabase's db container, it doesn't run its own Postgres.
POSTGRES_PASSWORD=changeme_use_a_long_random_password

# --- Backup retention ---
BACKUP_KEEP_DAYS=7
BACKUP_KEEP_WEEKS=4
BACKUP_KEEP_MONTHS=6
