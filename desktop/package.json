{
  "name": "auzslab-desktop",
  "productName": "AUZslab",
  "version": "1.0.0",
  "description": "AUZslab for Windows and Mac: the same hub as the web and phone apps (sign in, products, your account, team workspace, admin panel and every product app).",
  "main": "main.js",
  "author": "AUZslab <helloauzslab@gmail.com>",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --publish never"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "in.auzslab.desktop",
    "productName": "AUZslab",
    "files": ["main.js", "offline.html", "package.json"],
    "directories": { "buildResources": "build", "output": "dist" },
    "win": { "target": [{ "target": "nsis", "arch": ["x64"] }], "icon": "build/icon.png" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true },
    "mac": { "category": "public.app-category.business", "target": [{ "target": "dmg", "arch": ["universal"] }], "icon": "build/icon.png", "hardenedRuntime": true },
    "linux": { "target": ["AppImage"], "icon": "build/icon.png", "category": "Office" }
  }
}
