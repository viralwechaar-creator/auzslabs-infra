# Copy to .env for local use, or to /etc/auzslab-agents-office.env on the server (chmod 600). Never commit the real file.
ANTHROPIC_API_KEY=
# Made by: npm run set-password
OFFICE_PASSWORD_HASH=
OFFICE_SESSION_SECRET=
# Set to 1 only when running behind nginx/Caddy (so the real visitor IP is used for the login limit)
OFFICE_TRUST_PROXY=1
